NODE_ENV=production
PORT=3000
# MySQL/MariaDB de Hostinger. Usa los valores exactos de hPanel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
# Vacía esta variable si antes importaste una conexión PostgreSQL.
DATABASE_URL=
APP_URL=https://transportes.laincomoda.com.mx
PUBLIC_API_URL=https://transportes.laincomoda.com.mx
SESSION_SECRET=replace-with-at-least-32-random-characters
# Opcional: DATABASE_URL=mysql://usuario:clave_codificada@host:3306/base
# Mercado Pago queda pendiente hasta completar credenciales y cambiar MP_ENABLED=true.
MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:correo@example.com
# Correo queda pendiente hasta completar todos los datos y cambiar EMAIL_ENABLED=true.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Solo para compose.production.yaml; no se necesitan en Hostinger administrado.
DOMAIN=transportes.laincomoda.com.mx
MYSQL_ROOT_PASSWORD=
